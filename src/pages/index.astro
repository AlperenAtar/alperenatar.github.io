    .uz-alt { display: flex; justify-content: center; margin-top: 48px; }
  </style>

  <script is:inline>
    const GAS_BASE = document.body.dataset.api;
    const API_FOTO    = GAS_BASE + "?api=true";
    const API_ALBUM   = GAS_BASE + "?albumler=true";
    const API_YETKINLIK = GAS_BASE + "?yetkinlikler=true";
    const API_BELGE   = GAS_BASE + "?belgeler=true";
    const API_BLOG    = GAS_BASE + "?blog=true";
    const API_AYARLAR = GAS_BASE + "?ayarlar=true";

    // Boş şeffaf placeholder (görsel yüklenmezse)
    const PLACEHOLDER = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 5'%3E%3Crect width='4' height='5' fill='%23222'/%3E%3C/svg%3E";

    // --- Görsel çözümleyici: Drive / doğrudan link ---
    function resolveImg(url) {
      if (!url) return PLACEHOLDER;
      url = String(url).trim();
      if (url.includes("drive.google") || url.includes("docs.google")) {
        const m = url.match(/\/file\/d\/([a-zA-Z0-9_-]{10,})/)
               || url.match(/[?&]id=([a-zA-Z0-9_-]{10,})/)
               || url.match(/\/d\/([a-zA-Z0-9_-]{10,})/);
        if (m) return "https://drive.google.com/thumbnail?id=" + m[1] + "&sz=w2000";
      }
      return url;
    }

    

    // --- Video çözümleyici: YouTube / Vimeo / Drive / doğrudan dosya ---
    function ytId(u) { const m = String(u).match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|v\/)|youtu\.be\/)([a-zA-Z0-9_-]{6,})/); return m ? m[1] : null; }
    function vimeoId(u) { const m = String(u).match(/vimeo\.com\/(?:video\/)?(\d+)/); return m ? m[1] : null; }
    function driveId(u) {
      u = String(u);
      if (!(u.includes("drive.google") || u.includes("docs.google"))) return null;
      const m = u.match(/\/file\/d\/([a-zA-Z0-9_-]{10,})/) || u.match(/[?&]id=([a-zA-Z0-9_-]{10,})/) || u.match(/\/d\/([a-zA-Z0-9_-]{10,})/);
      return m ? m[1] : null;
    }
    function isVideoFile(u) { return /\.(mp4|webm|ogg|ogv|mov|m4v)(\?|#|$)/i.test(String(u)); }
    function isVideo(item) { return !!(item && item.video_linki && String(item.video_linki).trim()); }

    // Video kartı için poster/kapak belirle (öncelik: elle verilen kapak → YouTube/Drive'dan otomatik)
    function videoPoster(item) {
      if (item.drive_linki && String(item.drive_linki).trim()) return resolveImg(item.drive_linki);
      const v = item.video_linki || "";
      const y = ytId(v); if (y) return "https://img.youtube.com/vi/" + y + "/hqdefault.jpg";
      const d = driveId(v); if (d) return "https://drive.google.com/thumbnail?id=" + d + "&sz=w2000";
      return PLACEHOLDER;
    }

    // Lightbox içi oynatıcı HTML'i
    function playerHtml(v) {
      v = String(v || "").trim();
      const y = ytId(v);
      if (y) return '<iframe class="lb-player" src="https://www.youtube.com/embed/' + y + '?autoplay=1&rel=0&playsinline=1" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>';
      const vi = vimeoId(v);
      if (vi) return '<iframe class="lb-player" src="https://player.vimeo.com/video/' + vi + '?autoplay=1" allow="autoplay; fullscreen" allowfullscreen></iframe>';
      const d = driveId(v);
      if (d) return '<iframe class="lb-player" src="https://drive.google.com/file/d/' + d + '/preview" allow="autoplay" allowfullscreen></iframe>';
      if (isVideoFile(v)) return '<video class="lb-player" src="' + esc(v) + '" controls autoplay playsinline></video>';
      // Yandex Disk sayfası vb. gömülemeyen kaynaklar
      return '<div class="lb-external"><p>Bu video buraya gömülemiyor.</p><a href="' + esc(v) + '" target="_blank" rel="noopener">Kaynağında aç →</a></div>';
    }

    function esc(s) {
      return String(s == null ? "" : s)
        .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
    }
    function kirp(text, n) {
      const t = String(text || "").replace(/\s+/g, " ").trim();
      return t.length > n ? t.slice(0, n).trim() + "…" : t;
    }
    function shuffle(arr) {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
      return a;
    }

    // ===================== TEMA =====================
    const temaBtn = document.getElementById("tema-btn");
    temaBtn.addEventListener("click", () => {
      const cur = document.documentElement.getAttribute("data-theme");
      const next = cur === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try { localStorage.setItem("tema", next); } catch (e) {}
    });

    // ===================== LIGHTBOX =====================
    const lb = document.getElementById("lightbox");
    const lbMedia = document.getElementById("lb-media");
    const lbCap = document.getElementById("lb-cap");
    const lbCounter = document.getElementById("lb-counter");
    let lbList = [], lbIdx = 0;

    function lbOpen(items, start) {
      lbList = items; lbIdx = start || 0;
      lbRender(); lb.hidden = false; requestAnimationFrame(() => lb.classList.add("show"));
      document.body.style.overflow = "hidden";
    }
    function lbRender() {
      const it = lbList[lbIdx];
      if (isVideo(it)) {
        lbMedia.innerHTML = playerHtml(it.video_linki);
      } else {
        const kaynak = it.src || it.drive_linki;
        lbMedia.innerHTML = '<img class="lb-img" src="' + resolveImg(kaynak) + '" alt="' + esc(it.baslik || "") + '" onerror="this.src=\'' + PLACEHOLDER + '\'"/>';
      }
      lbCap.textContent = [it.baslik, it.aciklama].filter(Boolean).join(" — ");
      lbCounter.textContent = lbList.length > 1 ? (lbIdx + 1) + " / " + lbList.length : "";
      document.getElementById("lb-prev").hidden = lbList.length < 2;
      document.getElementById("lb-next").hidden = lbList.length < 2;
    }
    function lbClose() { lb.classList.remove("show"); lbMedia.innerHTML = ""; setTimeout(() => { lb.hidden = true; }, 300); document.body.style.overflow = ""; }
    function lbStep(d) { lbIdx = (lbIdx + d + lbList.length) % lbList.length; lbRender(); }
    document.getElementById("lb-close").onclick = lbClose;
    document.getElementById("lb-prev").onclick = () => lbStep(-1);
    document.getElementById("lb-next").onclick = () => lbStep(1);
    lb.addEventListener("click", (e) => { if (e.target === lb) lbClose(); });
    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") lbClose();
      if (e.key === "ArrowLeft") lbStep(-1);
      if (e.key === "ArrowRight") lbStep(1);
    });

    let albumBilgi = {};   // { albümAdı: { kapak, aciklama, kategori } }

    // ===================== ÇALIŞMALAR (albüm gruplama) =====================
    async function loadPortfolio() {
      const grid = document.getElementById("portfolio-grid");
      const loader = document.getElementById("loader");
      const count = document.getElementById("foto-count");
      const empty = document.getElementById("empty-state");
      try {
        const [data, albRes] = await Promise.all([
          fetch(API_FOTO).then((r) => r.json()),
          fetch(API_ALBUM).then((r) => r.json()).catch(() => [])
        ]);
        albumBilgi = {};
        (albRes || []).forEach((a) => {
          if (a.ad) albumBilgi[a.ad] = { kapak: a.kapak || "", aciklama: a.aciklama || "", kategori: a.kategori || "" };
        });
        loader.style.display = "none";
        if (!data || !data.length) { count.innerText = "0 çalışma"; empty.classList.remove("hidden"); return; }

        // Albümlere göre grupla; albümsüzler tekil kalır
        const albumler = {}; const tekiller = [];
        data.forEach((it) => {
          const a = (it["albüm"] || "").trim();
          if (a) { (albumler[a] = albumler[a] || []).push(it); }
          else { tekiller.push(it); }
        });

        const kartlar = [];
        Object.keys(albumler).forEach((ad) => kartlar.push({ tip: "album", ad, items: albumler[ad] }));
        tekiller.forEach((it) => kartlar.push({ tip: "tek", items: [it] }));

        document.getElementById("stat-albom").innerText = Object.keys(albumler).length;
        document.getElementById("stat-proje").innerText = data.length;
        count.innerText = kartlar.length + " çalışma";

        kartlar.slice(0, 12).forEach((k, i) => {
          const kapak = k.items[0];
          const isAlbum = k.tip === "album";
          const bilgi = isAlbum ? (albumBilgi[k.ad] || {}) : {};
          const elleKapak = !!(bilgi.kapak && String(bilgi.kapak).trim());
          const kapakVideo = elleKapak ? false : isVideo(kapak);
          const baslik = isAlbum ? k.ad : (kapak.baslik || "");
          const kategori = (isAlbum ? (bilgi.kategori || kapak.kategori) : kapak.kategori) || "";
          const aciklama = isAlbum ? (bilgi.aciklama || (k.items.length + " içerik")) : (kapak.aciklama || "");
          const kapakKaynak = elleKapak ? bilgi.kapak : (kapakVideo ? "" : kapak.drive_linki);
          const poster = elleKapak
            ? resolveImg(bilgi.kapak)
            : (kapakVideo ? videoPoster(kapak) : resolveImg(kapak.drive_linki));
          const rozet = isAlbum ? "ALBÜM" : (kapakVideo ? "VİDEO" : "KARE");

          const card = document.createElement("div");
          card.className = "portfolio-card";
          card.innerHTML =
            '<div class="card-frame">' +
              '<img src="' + poster + '" alt="' + esc(baslik) + '" loading="lazy" onerror="this.src=\'' + PLACEHOLDER + '\'"/>' +
              (kapakVideo ? '<span class="play-overlay"><span class="play-badge"><svg viewBox="0 0 24 24" width="20" height="20" fill="#fff"><path d="M8 5v14l11-7z"/></svg></span></span>' : '') +
              '<span class="frame-no">' + rozet + '</span>' +
              (kategori ? '<span class="card-cat">' + esc(kategori) + '</span>' : '') +
              (isAlbum ? '<span class="album-badge">◫ ' + k.items.length + '</span>' : '') +
            '</div>' +
            '<div class="card-meta"><h3>' + esc(baslik) + '</h3><p>' + esc(aciklama) + '</p></div>';

          card.addEventListener("click", () => {
            const items = k.items.map((x) => ({ src: x.drive_linki, video_linki: x.video_linki, baslik: x.baslik, aciklama: x.aciklama }));
            lbOpen(items, 0);
          });
          grid.appendChild(card);
        });

        animateCards();
        
        carInit();
      } catch (err) {
        console.error("Çalışmalar yüklenemedi:", err);
        loader.style.display = "none";
        empty.innerText = "Çalışmalar yüklenirken hata oluştu. API bağlantısını kontrol edin.";
        empty.classList.remove("hidden");
      }
    }

    // ===================== GÜNCE (6 rastgele) =====================
    async function loadJournal() {
      const grid = document.getElementById("journal-grid");
      const loader = document.getElementById("journal-loader");
      const empty = document.getElementById("journal-empty");
      try {
        const data = await (await fetch(API_BLOG)).json();
        loader.style.display = "none";
        document.getElementById("stat-yazi").innerText = (data && data.length) || 0;
        if (!data || !data.length) { empty.classList.remove("hidden"); return; }

        const secilen = shuffle(data).slice(0, 10);
        secilen.forEach((y) => {
          const giris = kirp(y.ozet || y.icerik, 85);
          const card = document.createElement("a");
          card.className = "jcard reveal-up";
          card.href = "/gunce?id=" + encodeURIComponent(y.id);
          card.innerHTML =
            '<div class="jcard-cover"><img src="' + resolveImg(y.kapak_gorseli) + '" alt="' + esc(y.baslik) + '" loading="lazy" onerror="this.style.opacity=0"/></div>' +
            (y.kategori ? '<span class="jcard-cat">' + esc(y.kategori) + '</span>' : '<span class="jcard-cat">GÜNCE</span>') +
            '<h3>' + esc(y.baslik) + '</h3>' +
            '<p>' + esc(giris) + '</p>' +
            '<span class="jcard-date">' + esc(y.tarih || "") + '</span>';
          grid.appendChild(card);
        });
        animateCards();
        jInit();
      } catch (err) {
        console.error("Günce yüklenemedi:", err);
        loader.style.display = "none";
        empty.classList.remove("hidden");
      }
    }

    // İletişim bağlantıları — WhatsApp adresi admin panelinde hazır üretiliyor
    function iletisimBaglantilari(a) {
      const igUrl = a.instagram
        ? (String(a.instagram).startsWith("http") ? a.instagram : "https://instagram.com/" + String(a.instagram).replace(/^@/, ""))
        : "";
      const wa = String(a.whatsapp || "").trim();
      const waUrl = wa.startsWith("http") ? wa : "";
      const mailUrl = a.email ? "mailto:" + String(a.email).trim() : "";
      return { igUrl, waUrl, mailUrl };
    }

    // ===================== AYARLAR (profil / iletişim) =====================
    async function loadAyarlar() {
      try {
        const a = await (await fetch(API_AYARLAR)).json();

        if (a.hakkimda_baslik) document.getElementById("about-baslik").innerText = a.hakkimda_baslik;
        if (a.hakkimda_metin) {
          document.getElementById("about-metin").innerHTML =
            String(a.hakkimda_metin).split(/\n{2,}|\n/).filter(Boolean)
              .map((p) => "<p>" + esc(p) + "</p>").join("");
        }
        if (a.profil_foto) {
          const frame = document.getElementById("about-frame");
          const img = document.createElement("img");
          img.src = resolveImg(a.profil_foto); img.alt = "Profil"; img.loading = "lazy";
          img.onerror = () => { img.remove(); };
          frame.prepend(img);
        }
        if (a.konum) {
          document.getElementById("contact-konum").innerText = a.konum;
          document.getElementById("hero-konum").innerText = String(a.konum).toUpperCase();
        }
        if (a.email) {
          const em = document.getElementById("contact-email");
          em.innerText = a.email; em.href = "mailto:" + a.email;
        }
        if (a.telefon) {
          const tel = document.getElementById("contact-tel");
          const digits = String(a.telefon).replace(/[^\d+]/g, "");
          tel.innerText = a.telefon; tel.href = "tel:" + digits; tel.hidden = false;
          document.getElementById("contact-tel-sep").hidden = false;
        }

        // Metin sosyal linkleri
        const social = document.getElementById("social-links");
        const ekle = (ad, url) => { if (url) { const el = document.createElement("a"); el.href = url; el.target = "_blank"; el.rel = "noopener"; el.innerText = ad; social.appendChild(el); } };
        const { igUrl, waUrl, mailUrl } = iletisimBaglantilari(a);
        ekle("Instagram", igUrl);
        ekle("Behance", a.behance || "");
        ekle("WhatsApp", waUrl);

        // Yüzen butonlar
        if (waUrl)   { const w = document.getElementById("fab-wa");   w.href = waUrl;   w.hidden = false; }
        if (igUrl)   { const g = document.getElementById("fab-ig");   g.href = igUrl;   g.hidden = false; }
        if (mailUrl) { const m = document.getElementById("fab-mail"); m.href = mailUrl; m.hidden = false; }
      } catch (err) {
        console.error("Ayarlar yüklenemedi:", err);
      }
    }

    // ===================== UZMANLIK ŞERİDİ =====================
    async function loadUzmanlik() {
      try {
        const [ytk, blg] = await Promise.all([
          fetch(API_YETKINLIK).then((r) => r.json()).catch(() => []),
          fetch(API_BELGE).then((r) => r.json()).catch(() => [])
        ]);

        let gorunur = false;

        // Yetkinlikler — en fazla 12 etiket
        if (ytk && ytk.length) {
          document.getElementById("uz-etiketler").innerHTML = ytk.slice(0, 12).map(function (y) {
            return '<span class="uz-etiket">' + esc(y.ad) + '</span>';
          }).join("");
          document.getElementById("uz-yetkinlik").hidden = false;
          gorunur = true;
        }

        // Sadece sertifikalar (CV ana sayfada gösterilmez)
        const sertifikalar = (blg || []).filter(function (b) {
          return (b.tip || "").toUpperCase() !== "CV";
        });
        if (sertifikalar.length) {
          document.getElementById("uz-sertifikalar").innerHTML = sertifikalar.slice(0, 8).map(function (b) {
            return '<a class="uz-sert" href="/hakkimda">' +
              '<div class="uz-sert-gorsel"><img src="' + resolveImg(b.link) + '" alt="' + esc(b.ad) + '" loading="lazy" onerror="this.style.opacity=0.2"></div>' +
              '<div class="uz-sert-ad">' + esc(b.ad) + '</div>' +
              (b.kurum ? '<div class="uz-sert-kurum">' + esc(b.kurum) + (b.yil ? " · " + esc(b.yil) : "") + '</div>' : '') +
            '</a>';
          }).join("");
          document.getElementById("uz-belge").hidden = false;
          gorunur = true;
        }

        if (gorunur) document.getElementById("uzmanlik").hidden = false;
      } catch (e) { console.error("Uzmanlık yüklenemedi:", e); }
    }

    // ===================== KARUSEL =====================
    let carIdx = 0, carTimer = null;
    const CAR_ADIM = 1;        // her tıklamada 2 içerik ilerle
    const CAR_SURE = 8000;     // otomatik kayma aralığı (ms)

    function carGorunen() {
      const w = window.innerWidth;
      if (w <= 640) return 1;
      if (w <= 900) return 2;
      if (w <= 1200) return 3;
      return 4;
    }
    function carUygula() {
      const track = document.getElementById("portfolio-grid");
      const ilk = track.children[0];
      if (!ilk) return;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 24;
      const adim = ilk.getBoundingClientRect().width + gap;
      track.style.transform = "translateX(-" + (carIdx * adim) + "px)";
    }
    function carGit(yon, elle) {
      const track = document.getElementById("portfolio-grid");
      const enFazla = Math.max(0, track.children.length - carGorunen());
      carIdx += yon * CAR_ADIM;
      if (carIdx > enFazla) carIdx = 0;          // sona gelince başa dön
      if (carIdx < 0) carIdx = enFazla;          // başta geriye basınca sona git
      carUygula();
      if (elle) carSayaciSifirla();              // kullanıcı müdahale ettiyse sayaç sıfırlanır
    }
    function carSayaciSifirla() {
      clearInterval(carTimer);
      carTimer = setInterval(() => carGit(1, false), CAR_SURE);
    }
    function carInit() {
      const track = document.getElementById("portfolio-grid");
      const car = document.getElementById("carousel");
      if (!track.children.length) { car.style.display = "none"; return; }

      // Her şey ekrana sığıyorsa oklara ve otomatik kaymaya gerek yok
      if (track.children.length <= carGorunen()) {
        document.getElementById("car-prev").style.display = "none";
        document.getElementById("car-next").style.display = "none";
        return;
      }

      document.getElementById("car-prev").onclick = () => carGit(-1, true);
      document.getElementById("car-next").onclick = () => carGit(1, true);

      // Fare üzerindeyken otomatik kayma dursun
      car.addEventListener("mouseenter", () => clearInterval(carTimer));
      car.addEventListener("mouseleave", carSayaciSifirla);

      window.addEventListener("resize", () => { carIdx = 0; carUygula(); });
      carDokunmaBagla(track, car);

      carUygula();
      carSayaciSifirla();
    }

    // Parmakla / fareyle sürükleyerek kaydırma
    function carDokunmaBagla(track, car) {
      const viewport = car.querySelector(".car-viewport");
      let baslangicX = 0, baslangicY = 0, suruklendi = 0;
      let aktif = false, yonBelli = false, yatay = false, baslangicIdx = 0;

      function kartGenislik() {
        const ilk = track.children[0];
        if (!ilk) return 1;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 24;
        return ilk.getBoundingClientRect().width + gap;
      }

      function basla(x, y) {
        aktif = true; yonBelli = false; yatay = false;
        baslangicX = x; baslangicY = y; suruklendi = 0;
        baslangicIdx = carIdx;
        clearInterval(carTimer);
        track.classList.add("suruklu");
        viewport.classList.add("suruklu");
      }

      function hareket(x, y, ev) {
        if (!aktif) return;
        const dx = x - baslangicX;
        const dy = y - baslangicY;

        // İlk 8px'te yönü belirle: dikeyse karuseli bırak, sayfa kaysın
        if (!yonBelli && (Math.abs(dx) > 8 || Math.abs(dy) > 8)) {
          yonBelli = true;
          yatay = Math.abs(dx) > Math.abs(dy);
          if (!yatay) { bitir(); return; }
        }
        if (!yatay) return;
        if (ev && ev.cancelable) ev.preventDefault();

        suruklendi = dx;
        const adim = kartGenislik();
        track.style.transform = "translateX(" + (-(baslangicIdx * adim) + dx) + "px)";
      }

      function bitir() {
        if (!aktif) return;
        aktif = false;
        track.classList.remove("suruklu");
        viewport.classList.remove("suruklu");

        const adim = kartGenislik();
        const enFazla = Math.max(0, track.children.length - carGorunen());

        // Kart genişliğinin %20'sini geçtiyse kaydır
        if (Math.abs(suruklendi) > adim * 0.2) {
          const kayan = Math.round(Math.abs(suruklendi) / adim) || 1;
          carIdx = baslangicIdx + (suruklendi < 0 ? kayan : -kayan);
          if (carIdx > enFazla) carIdx = enFazla;
          if (carIdx < 0) carIdx = 0;
        } else {
          carIdx = baslangicIdx;
        }
        carUygula();
        carSayaciSifirla();
      }

      // Dokunma
      viewport.addEventListener("touchstart", function (e) {
        basla(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });
      viewport.addEventListener("touchmove", function (e) {
        hareket(e.touches[0].clientX, e.touches[0].clientY, e);
      }, { passive: false });
      viewport.addEventListener("touchend", bitir);
      viewport.addEventListener("touchcancel", bitir);

      // Fare (masaüstünde de sürüklenebilsin)
      viewport.addEventListener("mousedown", function (e) {
        e.preventDefault(); basla(e.clientX, e.clientY);
      });
      window.addEventListener("mousemove", function (e) { hareket(e.clientX, e.clientY, null); });
      window.addEventListener("mouseup", bitir);

      // Sürükledikten sonra kartın tıklanmasını engelle
      track.addEventListener("click", function (e) {
        if (Math.abs(suruklendi) > 6) { e.preventDefault(); e.stopPropagation(); }
      }, true);
    }

    // ===================== GÜNCE ŞERİDİ (mobil otomatik kayma) =====================
    let jTimer = null;

    function jSayaciSifirla(grid) {
      clearInterval(jTimer);
      jTimer = setInterval(function () {
        // Şerit modunda değilse (masaüstü ızgara) bir şey yapma
        if (grid.scrollWidth <= grid.clientWidth + 4) return;

        const ilk = grid.children[0];
        if (!ilk) return;
        const gap = parseFloat(getComputedStyle(grid).columnGap) || 14;
        const adim = (ilk.getBoundingClientRect().width + gap) * 2;   // 2 kart ilerle

        // Sona geldiyse başa dön
        if (grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 4) {
          grid.scrollTo({ left: 0, behavior: "smooth" });
        } else {
          grid.scrollBy({ left: adim, behavior: "smooth" });
        }
      }, CAR_SURE);
    }

    function jInit() {
      const grid = document.getElementById("journal-grid");
      if (!grid || !grid.children.length) return;

      // Kullanıcı elle kaydırınca sayaç sıfırlansın
      let bekle;
      grid.addEventListener("scroll", function () {
        clearInterval(jTimer);
        clearTimeout(bekle);
        bekle = setTimeout(function () { jSayaciSifirla(grid); }, 2500);
      }, { passive: true });

      grid.addEventListener("touchstart", function () { clearInterval(jTimer); }, { passive: true });
      grid.addEventListener("mouseenter", function () { clearInterval(jTimer); });
      grid.addEventListener("mouseleave", function () { jSayaciSifirla(grid); });

      jSayaciSifirla(grid);
    }

    // ===================== ANİMASYON =====================
    function animateCards() {
      if (!window.gsap) return;
      gsap.utils.toArray(".reveal-up:not(.gs-done)").forEach((el, i) => {
        el.classList.add("gs-done");
        gsap.fromTo(el, { y: 34, opacity: 0 }, {
          y: 0, opacity: 1, duration: 0.8, ease: "power3.out",
          delay: (i % 3) * 0.06, scrollTrigger: { trigger: el, start: "top 90%" }
        });
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
      document.getElementById("yil").innerText = new Date().getFullYear();

      if (window.gsap) {
        gsap.registerPlugin(ScrollTrigger);
        gsap.fromTo(".gs-reveal", { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 1, stagger: 0.12, ease: "power2.out", delay: 0.2 });
        animateCards();
      }

      loadPortfolio();
      loadJournal();
      loadAyarlar();
      loadUzmanlik();

      // Nav arka planı + yüzen butonlar scroll'a göre
      const nav = document.getElementById("nav");
      
      const onScroll = () => {
        const y = window.scrollY;
        nav.style.background = y > 40 ? "color-mix(in srgb, var(--bg) 82%, transparent)" : "transparent";
        
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    });

    // ===== MOBİL MENÜ =====
    (function mobilMenu() {
      const burger = document.getElementById("nav-burger");
      const links = document.getElementById("nav-links");
      const overlay = document.getElementById("nav-overlay");
      if (!burger || !links || !overlay) return;

      function ac() {
        links.classList.add("acik"); overlay.classList.add("acik"); burger.classList.add("acik");
        burger.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      }
      function kapat() {
        links.classList.remove("acik"); overlay.classList.remove("acik"); burger.classList.remove("acik");
        burger.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      }
      burger.addEventListener("click", function () {
        links.classList.contains("acik") ? kapat() : ac();
      });
      overlay.addEventListener("click", kapat);
      links.querySelectorAll("a").forEach(function (a) { a.addEventListener("click", kapat); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape") kapat(); });
    })();


  </script>
</body>
